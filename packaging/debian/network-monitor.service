[Unit]
Description=Network Monitor
After=network.target

[Service]
Type=simple
User=network-monitor
Group=network-monitor
ExecStart=/usr/bin/network-monitor --config /etc/network-monitor/config.ini monitor
WorkingDirectory=/var/lib/network-monitor
StateDirectory=network-monitor
StateDirectoryMode=0755
UMask=0022
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
